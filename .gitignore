# macOS
.DS_Store

# Go（daemon）——dist/ 为本地构建产物；udev/systemd 安装物在 daemon/packaging/ 入库
daemon/dist/
*.test
*.out

# GoReleaser 发布产物（goreleaser release --snapshot 本地验证时生成）
/dist/

# 鸿蒙工程（apps/harmony）
**/oh_modules/
**/.hvigor/
**/build/
**/.preview/
**/.clangd/
**/.clang-format/
**/.clang-tidy
**/local.properties
*.har

# 签名与证书一律不入库
*.p7b
*.cer
*.p12
signing/
# DevEco 自动签名会把签名材料（含本机绝对路径与加密口令）写进本文件——
# 一律不入库；首次克隆从 build-profile.json5.template 复制生成
apps/harmony/build-profile.json5

# 临时与日志
node_modules/
*.log
tmp/

# Go 本地构建误产物（go build 无 -o 时落在模块根）
daemon/padlinkd
daemon/padlinktoy
