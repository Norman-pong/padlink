{
  "app": {
    "bundleName": "com.zhimingcool.padlink",
    "vendor": "example",
    // versionCode = major×1e6 + minor×1e4 + patch×1e2，须与 versionName 同步（发版 CI 校验）
    "versionCode": 1020000,
    "versionName": "1.2.0",
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    // 系统字号跟随（faqs-ability-166 / hds-components.md §四）：
    // 必须 profile 文件引用，内联对象写法 hvigor schema 直接拒绝构建。
    "configuration": "$profile:configuration"
  }
}
