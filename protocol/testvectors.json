{
  "spec": "PadLink wire protocol v1 golden vectors (single source of truth for cross-implementation testing)",
  "consumer": "HarmonyOS app + Go daemon must both pass all vectors; generate more via daemon/internal/proto",
  "header_layout": "magic(2B 'PL') | ver(1B) | type(1B) | flags(1B) | seq(2B) | payload_len(2B) | reserved(2B) | hmac_trunc(8B) | payload(<=1400B)",
  "header_size_bytes": 19,
  "note_prd_discrepancy": "PRD v1.0 §5.2 says '16 字节' header, but its field list sums to 19 bytes; the field list is authoritative and these vectors pin 19 bytes. Any change must be decided in protocol/ first.",
  "byte_order": "big-endian for seq/payload_len/reserved and all multi-byte payload integers",
  "flags": {
    "0x01": "FlagAuth: hmac_trunc is HMAC-SHA256(token, header-with-zeroed-hmac || payload)[0:8]"
  },
  "token_hex": "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
  "token_note": "32-byte DEMO token for vectors only; real tokens are random 32B issued at pairing (PRD §4.1)",
  "types": {
    "1": "HELLO",
    "2": "DISCOVER_RESP",
    "3": "PAIR_REQ",
    "4": "PAIR_OK",
    "5": "PAIR_NAK",
    "6": "MOVE",
    "7": "SCROLL",
    "8": "BUTTON",
    "9": "KEY",
    "10": "TEXT",
    "11": "ECHO",
    "12": "BYE",
    "13": "ERR",
    "14": "NOTICE"
  },
